---
layout: base.njk
---
<article class="article container narrow">
  <header class="article-header">
    <p class="eyebrow">Research notes</p>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if readingTime %}<span>· {{ readingTime }}</span>{% endif %}
    </div>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <footer class="article-footer">
    <a class="text-link" href="/blog/">← Back to all research notes</a>
  </footer>
</article>
