<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.shortName }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if page.url and '/blog/' in page.url and page.url != '/blog/' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <link rel="alternate" type="application/rss+xml" title="{{ site.shortName }} — Research Notes" href="/feed.xml">
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script defer src="/assets/js/main.js"></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.name }}",
    "jobTitle": "{{ site.role }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <span class="brand-mark">DP</span>
        <span class="brand-text">
          <strong>{{ site.shortName }}</strong>
          <small>Researcher</small>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
        <a href="/about/">About</a>
        <a href="/research/">Research</a>
        <a href="/publications/">Publications</a>
        <a href="/projects/">Projects</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <strong>{{ site.name }}</strong>
        <p>{{ site.role }} · {{ site.location }}</p>
      </div>
      <div class="footer-links">
        {% if site.googleScholar %}<a href="{{ site.googleScholar }}">Google Scholar</a>{% endif %}
        {% if site.orcid %}<a href="{{ site.orcid }}">ORCID</a>{% endif %}
        {% if site.linkedin %}<a href="{{ site.linkedin }}">LinkedIn</a>{% endif %}
        <a href="/feed.xml">RSS</a>
      </div>
    </div>
    <div class="container footer-meta">
      <span>© {{ buildYear }} {{ site.shortName }}</span>
      <span>Built as a static site with Eleventy.</span>
    </div>
  </footer>
</body>
</html>
